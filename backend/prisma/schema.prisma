generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  SUPERADMIN
  ADMINISTRADOR
  VENDEDOR
  CAJERO
  CLIENTE
}

enum EstadoNegocio {
  PENDIENTE
  ACTIVO
  BLOQUEADO
}

enum PropositoCodigo {
  ACTIVACION
  RECUPERACION
}

enum EstadoPedido {
  PENDIENTE_PAGO
  PAGADO
  CANCELADO
  ENTREGADO
}

enum ProveedorPago {
  PAYPAL
  PAYPHONE
}

model Negocio {
  id        String           @id @default(uuid())
  nombre    String
  slug      String           @unique
  plan      String           @default("MULTI")
  estado    EstadoNegocio    @default(PENDIENTE)
  creadoEn  DateTime         @default(now()) @map("creado_en")
  socios    Socio[]
  productos Producto[] // ← Productos pertenecen al Negocio
  ventas    Venta[] // ← Ventas pertenecen al Negocio
  clientes  ClienteNegocio[]
  pedidos   Pedido[]

  @@map("negocios")
}

model Socio {
  id                  String           @id @default(uuid())
  negocioId           String?
  negocio             Negocio?         @relation(fields: [negocioId], references: [id])
  nombre              String
  cedula              String?          @unique // <- Añadir para el RUC/Cédula
  email               String           @unique
  password            String
  cuentaActivada      Boolean          @default(true) @map("cuenta_activada")
  codigoVerificacionHash String?        @map("codigo_verificacion_hash")
  codigoVerificacionExpira DateTime?    @map("codigo_verificacion_expira")
  codigoVerificacionEnviadoEn DateTime? @map("codigo_verificacion_enviado_en")
  intentosVerificacion Int              @default(0) @map("intentos_verificacion")
  propositoCodigo       PropositoCodigo? @map("proposito_codigo")
  rol                 Rol              @default(CLIENTE)
  ventasRealizadas    Venta[]          @relation("VendedorFactura")
  compras             Venta[]          @relation("ClienteFactura")
  negociosComoCliente ClienteNegocio[]
  pedidos             Pedido[]

  @@map("socios")
}

model ClienteNegocio {
  id               String   @id @default(uuid())
  clienteId        String   @map("cliente_id")
  negocioId        String   @map("negocio_id")
  nombreReferencia String?  @map("nombre_referencia")
  emailContacto    String?  @map("email_contacto")
  activo           Boolean  @default(true)
  creadoEn         DateTime @default(now()) @map("creado_en")

  cliente Socio   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  negocio Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@unique([clienteId, negocioId])
  @@index([negocioId])
  @@map("clientes_negocios")
}

model Producto {
  id          String         @id @default(uuid())
  negocioId   String         @map("negocio_id") // ← CAMBIADO
  negocio     Negocio        @relation(fields: [negocioId], references: [id])
  nombre      String
  valor       Decimal
  stock       Int            @default(0)
  imagenUrl   String?        @map("imagen_url")
  descripcion String?
  qrCode      String?        @map("qr_code")
  activo      Boolean        @default(true)
  creadoEn    DateTime       @default(now()) @map("creado_en")
  detalles    DetalleVenta[]
  alertas     Alerta[]
  detallesPedido DetallePedido[]

  @@map("productos")
}

model Venta {
  id        String  @id @default(uuid())
  negocioId String  @map("negocio_id")
  negocio   Negocio @relation(fields: [negocioId], references: [id])

  // VENDEDOR / CAJERO
  socioId String? @map("socio_id")
  socio   Socio?  @relation("VendedorFactura", fields: [socioId], references: [id])

  // CLIENTE
  clienteId String? @map("cliente_id")
  cliente   Socio?  @relation("ClienteFactura", fields: [clienteId], references: [id])

  subtotal  Decimal @default(0)
  impuestos Decimal @default(0)
  total     Decimal

  // 💻 NUEVO CAMPO: Para almacenar el método de pago seleccionado en la caja
  metodoPago String @default("EFECTIVO") @map("metodo_pago")

  pedidoId String? @unique @map("pedido_id")
  pedido   Pedido? @relation(fields: [pedidoId], references: [id], onDelete: Restrict)

  creadoEn DateTime       @default(now()) @map("creado_en")
  detalles DetalleVenta[]

  @@map("ventas")
}

model Pedido {
  id        String       @id @default(uuid())
  negocioId String       @map("negocio_id")
  clienteId String       @map("cliente_id")
  estado    EstadoPedido @default(PENDIENTE_PAGO)

  subtotal  Decimal @db.Decimal(12, 2)
  impuestos Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)
  moneda    String  @default("USD")

  proveedorPago       ProveedorPago? @map("proveedor_pago")
  referenciaOrdenPago String?        @map("referencia_orden_pago")
  referenciaPago      String?        @map("referencia_pago")

  expiraEn      DateTime? @map("expira_en")
  pagadoEn      DateTime? @map("pagado_en")
  canceladoEn   DateTime? @map("cancelado_en")
  entregadoEn   DateTime? @map("entregado_en")
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")

  negocio  Negocio         @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  cliente  Socio           @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  detalles DetallePedido[]
  venta    Venta?

  @@unique([proveedorPago, referenciaOrdenPago])
  @@unique([proveedorPago, referenciaPago])
  @@index([clienteId, creadoEn])
  @@index([negocioId, estado])
  @@map("pedidos")
}

model DetallePedido {
  id             String  @id @default(uuid())
  pedidoId       String  @map("pedido_id")
  productoId     String  @map("producto_id")
  cantidad       Int
  nombreProducto String  @map("nombre_producto")
  precioUnit     Decimal @map("precio_unit") @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  pedido   Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@unique([pedidoId, productoId])
  @@index([productoId])
  @@map("detalle_pedidos")
}

model DetalleVenta {
  id         String   @id @default(uuid())
  ventaId    String   @map("venta_id")
  productoId String   @map("producto_id")
  cantidad   Int
  precioUnit Decimal  @map("precio_unit")
  venta      Venta    @relation(fields: [ventaId], references: [id])
  producto   Producto @relation(fields: [productoId], references: [id])

  @@map("detalle_ventas")
}

model Alerta {
  id         String   @id @default(uuid())
  productoId String   @map("producto_id")
  mensaje    String
  creadoEn   DateTime @default(now()) @map("creado_en")
  producto   Producto @relation(fields: [productoId], references: [id])

  @@map("alertas")
}

model SesionCaja {
  id       String   @id @default(uuid())
  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("sesiones_caja")
}
