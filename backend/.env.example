DATABASE_URL="postgresql://usuario:password@localhost:5432/anderson"
JWT_SECRET="cambiar-por-un-secreto-seguro"
FRONTEND_URL="http://localhost:4200"

# Ollama se ejecuta localmente. Cambia el modelo si el equipo tiene pocos recursos.
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:0.5b"

EMAIL_USER="cuenta@gmail.com"
EMAIL_APP_PASSWORD="contraseña-de-aplicacion"
EMAIL_NAME_AUTH="Seguridad MiNegocio"
EMAIL_NAME_FACTURAS="Facturación MiNegocio"
CODE_TTL_MINUTES="5"
MAX_VERIFICATION_ATTEMPTS="5"

PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

PAYPHONE_BASE_URL="https://pay.payphonetodoesposible.com"
PAYPHONE_TOKEN=""
PAYPHONE_STORE_ID=""

# PocketBase Storage para logos de empresas.
# Crea una colección base "negocio_logos" con:
# - negocioId: campo text obligatorio
# - logo: campo file, máximo 1 archivo / 2 MB, MIME JPG, PNG y WEBP
POCKETBASE_URL="http://127.0.0.1:8090"
POCKETBASE_LOGOS_COLLECTION="negocio_logos"
POCKETBASE_TOKEN=""
# Alternativa al token: credenciales de un superusuario (solo en backend).
POCKETBASE_SUPERUSER_EMAIL=""
POCKETBASE_SUPERUSER_PASSWORD=""
